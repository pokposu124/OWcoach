{
  "$defs": {
    "ActionItem": {
      "properties": {
        "task": {
          "title": "Task",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        },
        "related_feedback_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Feedback Ids",
          "type": "array"
        }
      },
      "required": [
        "task",
        "why",
        "related_feedback_ids"
      ],
      "title": "ActionItem",
      "type": "object"
    },
    "CostSummary": {
      "properties": {
        "estimated": {
          "default": true,
          "title": "Estimated",
          "type": "boolean"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "note"
      ],
      "title": "CostSummary",
      "type": "object"
    },
    "DiscardedItem": {
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "scene_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "summary"
      ],
      "title": "DiscardedItem",
      "type": "object"
    },
    "EvidenceFrame": {
      "properties": {
        "timestamp_seconds": {
          "title": "Timestamp Seconds",
          "type": "number"
        },
        "path": {
          "description": "run 디렉터리 기준 상대 경로",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "timestamp_seconds",
        "path"
      ],
      "title": "EvidenceFrame",
      "type": "object"
    },
    "FeedbackItem": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "start_time_seconds": {
          "title": "Start Time Seconds",
          "type": "number"
        },
        "end_time_seconds": {
          "title": "End Time Seconds",
          "type": "number"
        },
        "category": {
          "enum": [
            "positioning",
            "survival",
            "skill_usage"
          ],
          "title": "Category",
          "type": "string"
        },
        "observation": {
          "title": "Observation",
          "type": "string"
        },
        "assessment": {
          "title": "Assessment",
          "type": "string"
        },
        "suggestion": {
          "title": "Suggestion",
          "type": "string"
        },
        "evidence_frame_timestamps": {
          "items": {
            "type": "number"
          },
          "title": "Evidence Frame Timestamps",
          "type": "array"
        },
        "uncertainty": {
          "title": "Uncertainty",
          "type": "string"
        },
        "hero": {
          "title": "Hero",
          "type": "string"
        },
        "patch_version": {
          "title": "Patch Version",
          "type": "string"
        },
        "judgement": {
          "enum": [
            "good",
            "needs_improvement",
            "withheld"
          ],
          "title": "Judgement",
          "type": "string"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "uncertainty_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Uncertainty Level",
          "type": "string"
        },
        "criterion_ids": {
          "items": {
            "type": "string"
          },
          "title": "Criterion Ids",
          "type": "array"
        },
        "criteria_review_status": {
          "enum": [
            "draft",
            "approved",
            "none"
          ],
          "title": "Criteria Review Status",
          "type": "string"
        },
        "display_mode": {
          "enum": [
            "assertive",
            "tentative"
          ],
          "title": "Display Mode",
          "type": "string"
        },
        "display_reasons": {
          "description": "tentative 로 표시된 이유",
          "items": {
            "type": "string"
          },
          "title": "Display Reasons",
          "type": "array"
        },
        "evidence_frames": {
          "items": {
            "$ref": "#/$defs/EvidenceFrame"
          },
          "title": "Evidence Frames",
          "type": "array"
        },
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start_time_seconds",
        "end_time_seconds",
        "category",
        "observation",
        "assessment",
        "suggestion",
        "evidence_frame_timestamps",
        "uncertainty",
        "hero",
        "patch_version",
        "judgement",
        "confidence",
        "uncertainty_level",
        "criterion_ids",
        "criteria_review_status",
        "display_mode",
        "display_reasons",
        "evidence_frames",
        "scene_id"
      ],
      "title": "FeedbackItem",
      "type": "object"
    },
    "StageUsage": {
      "properties": {
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prompt Version"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "thinking_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        },
        "input_tokens_by_modality": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Input Tokens By Modality",
          "type": "object"
        },
        "latency_seconds": {
          "title": "Latency Seconds",
          "type": "number"
        },
        "from_cache": {
          "default": false,
          "title": "From Cache",
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "model",
        "prompt_version",
        "latency_seconds"
      ],
      "title": "StageUsage",
      "type": "object"
    },
    "Versions": {
      "properties": {
        "pipeline": {
          "title": "Pipeline",
          "type": "string"
        },
        "result_schema": {
          "title": "Result Schema",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "sdk": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sdk"
        },
        "prompts": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prompts",
          "type": "object"
        },
        "hero_profile": {
          "title": "Hero Profile",
          "type": "string"
        },
        "hero_profile_review_status": {
          "title": "Hero Profile Review Status",
          "type": "string"
        },
        "config_fingerprint": {
          "title": "Config Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "pipeline",
        "result_schema",
        "provider",
        "model",
        "sdk",
        "prompts",
        "hero_profile",
        "hero_profile_review_status",
        "config_fingerprint"
      ],
      "title": "Versions",
      "type": "object"
    },
    "VideoInfo": {
      "properties": {
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fps"
        },
        "codec": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Codec"
        }
      },
      "required": [
        "file_name",
        "sha256",
        "duration_seconds",
        "width",
        "height",
        "fps",
        "codec"
      ],
      "title": "VideoInfo",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "analysis_mode": {
      "enum": [
        "real",
        "mock"
      ],
      "title": "Analysis Mode",
      "type": "string"
    },
    "notice": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notice"
    },
    "hero": {
      "title": "Hero",
      "type": "string"
    },
    "hero_display_name": {
      "title": "Hero Display Name",
      "type": "string"
    },
    "game_patch_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Game Patch Version"
    },
    "criteria_patch_version": {
      "title": "Criteria Patch Version",
      "type": "string"
    },
    "video": {
      "$ref": "#/$defs/VideoInfo"
    },
    "overview": {
      "additionalProperties": true,
      "title": "Overview",
      "type": "object"
    },
    "feedback": {
      "items": {
        "$ref": "#/$defs/FeedbackItem"
      },
      "title": "Feedback",
      "type": "array"
    },
    "action_items": {
      "items": {
        "$ref": "#/$defs/ActionItem"
      },
      "title": "Action Items",
      "type": "array"
    },
    "discarded": {
      "items": {
        "$ref": "#/$defs/DiscardedItem"
      },
      "title": "Discarded",
      "type": "array"
    },
    "versions": {
      "$ref": "#/$defs/Versions"
    },
    "timings_seconds": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Timings Seconds",
      "type": "object"
    },
    "usage": {
      "items": {
        "$ref": "#/$defs/StageUsage"
      },
      "title": "Usage",
      "type": "array"
    },
    "cost": {
      "$ref": "#/$defs/CostSummary"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "analysis_mode",
    "hero",
    "hero_display_name",
    "game_patch_version",
    "criteria_patch_version",
    "video",
    "overview",
    "feedback",
    "action_items",
    "discarded",
    "versions",
    "timings_seconds",
    "usage",
    "cost",
    "warnings",
    "created_at"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
