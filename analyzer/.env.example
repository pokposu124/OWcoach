# 분석기 실행에 필요한 환경 변수. 이 파일을 .env로 복사하지 말고 셸에서 export 하거나
# `set -a; source .env; set +a` 로 불러오세요. (.env는 .gitignore에 포함됨)

# Gemini API 키 (Google AI Studio에서 발급). 결제(유료 등급) 연결된 프로젝트의 키를 권장:
# 무료 등급은 입력 데이터가 Google 제품 개선에 사용될 수 있음 -> README "데이터 사용" 참고
GEMINI_API_KEY=

# 사용할 모델 ID. 추측하지 말고 공식 모델 목록(https://ai.google.dev/gemini-api/docs/models)에서
# 영상 입력을 지원하는 모델을 확인해 정확한 ID를 넣으세요. 비워두면 실행이 거부됩니다.
OWCOACH_GEMINI_MODEL=

# (선택) 기본 설정 파일 대신 사용할 경로
# OWCOACH_CONFIG=config/analysis.yaml
# OWCOACH_PRICING=config/pricing.yaml
